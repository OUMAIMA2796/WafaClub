# WafaClub — copier ce fichier vers .env et adapter les valeurs.
# Aucune valeur secrète réelle ne doit être versionnée.

# SQLite (démo locale, aucune installation) :
DATABASE_URL=sqlite:///data/wafaclub.db

# PostgreSQL (recommandé avant pilote / production) :
# DATABASE_URL=postgresql+psycopg://wafaclub:wafaclub_dev_password@localhost:5432/wafaclub

# Remplit la base avec les données de démonstration au premier démarrage.
# À passer à false en production.
WAFACLUB_AUTO_SEED=true

# Environnement : development | staging | production
WAFACLUB_ENV=development

# Limitation des tentatives de connexion (MVP).
WAFACLUB_LOGIN_MAX_ATTEMPTS=5
WAFACLUB_LOGIN_WINDOW_MINUTES=15

# Secret d'application (réservé aux futures sessions signées / intégrations).
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
WAFACLUB_APP_SECRET=change-me-in-local-only

# Simulation de paiement uniquement. Aucun prestataire de paiement réel.
WAFACLUB_PAYMENTS_MODE=simulated
